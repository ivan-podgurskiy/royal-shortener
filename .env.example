# Optional overrides for `docker compose up`.
# Copy to .env if you need them.

# Session signing key — generate with: openssl rand -base64 64
# SECRET_KEY_BASE=

# SQLite path (default: /data/royal.sqlite3 on the royal-data volume)
# DATABASE_URL=/data/royal.sqlite3

# MaxMind GeoLite2 country database for analytics (optional).
# docker compose cp GeoLite2-Country.mmdb app:/geoip/GeoLite2-Country.mmdb
# GEOIP_DB_PATH=/geoip/GeoLite2-Country.mmdb
